# Hosted PostgreSQL. Keep the actual URI in Vercel or an ignored local .env file.
DATABASE_URL=

# Existing Privy application. Enable Solana wallet login in its dashboard.
AUVEN_PRIVY_APP_ID=
AUVEN_PRIVY_APP_SECRET=

# Server-side secrets. Use a stable 32-byte hex signing seed.
AUVEN_SETUP_TOKEN=
AUVEN_PQ_SIGNING_SEED=

# Supported provider route
AUVEN_OPENAI_API_KEY=
AUVEN_MODEL=gpt-6.1-sol

# Proof publisher. Use a dedicated Solana wallet, not a personal wallet.
# The secret may be a Base58 private key exported by a wallet or a 64-byte JSON array.
AUVEN_SOLANA_RPC_URL=
AUVEN_SOLANA_SECRET_KEY=

# Public mint; embedded as the app default. Override only if needed.
AUVEN_SOLANA_TOKEN_MINT=DXf5UDjzYFEizcroAHx1jhtFLf6EEuWcSokgNfAhpump
