# Supabase Connect → Transaction pooler. Keep the real URI in Vercel, not Git.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres

# Supabase Project Settings → API. Both values are public configuration;
# the server validates access tokens against Supabase Auth.
AUVEN_SUPABASE_URL=https://PROJECT_REF.supabase.co
AUVEN_SUPABASE_PUBLISHABLE_KEY=

# Use random values generated locally. Configure these as Vercel secrets.
AUVEN_SETUP_TOKEN=
AUVEN_PQ_SIGNING_SEED=

# Optional supported provider
AUVEN_OPENAI_API_KEY=
AUVEN_MODEL=gpt-4o-mini

# Optional Robinhood Chain mainnet signer and production RPC
AUVEN_RH_PRIVATE_KEY=
AUVEN_RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Set only after deploying contracts/AuvenProofRegistry.sol and verifying its address.
AUVEN_RH_REGISTRY_ADDRESS=
