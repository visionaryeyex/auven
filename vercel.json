{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": { "api/route.js": { "maxDuration": 60 } },
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/route?auven_path=:path*" }]
}
