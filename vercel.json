{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": { "api/route.js": { "maxDuration": 60 } },
  "redirects": [
    { "source": "/workspace/discover", "destination": "/workspace/marketplace", "permanent": true },
    { "source": "/token", "destination": "/roadmap", "permanent": true },
    { "source": "/token.html", "destination": "/roadmap", "permanent": true }
  ],
  "rewrites": [{ "source": "/mcp", "destination": "/api/route?auven_path=mcp" }, { "source": "/api/:path*", "destination": "/api/route?auven_path=:path*" }, { "source": "/workspace", "destination": "/" }, { "source": "/workspace/:section", "destination": "/" }]
}
